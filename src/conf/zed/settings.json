// Zed user settings, copied to ~/.config/zed/settings.json by setup-macos.sh.
//
// A starting point, not a live link. Zed writes to its settings file — the SSH
// connections you open, remote endpoints, whatever the settings UI touches — so
// anything host-specific belongs in your ~/.config copy and never here.
//
// Zed reads this as JSONC, so the reasoning can live next to the setting.
// Everything not listed here is deliberately left at Zed's default.
{
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": "Zed (Default)",

  // Cursor and VS Code are the editors of record, so Zed inherits their
  // bindings rather than asking for a third set of muscle memory. keymap.json
  // holds only the handful this doesn't cover.
  "base_keymap": "Cursor",

  // Installed by the font-fira-code-nerd-font cask in src/conf/Brewfile, the
  // same family src/conf/ghostty/config asks for. Ligatures off there and off
  // here: calt carries the .. spacing, liga and dlig the arrows and !=.
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 15,
  "buffer_font_features": {
    "calt": false,
    "liga": false,
    "dlig": false
  },

  // Follows the macOS appearance. Both are built-in themes, so this works on a
  // fresh install with no extensions fetched yet.
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark"
  },

  // Zed's built-in terminal, kept visually consistent with Ghostty. The shell
  // is left at Zed's default (your login shell), which picks up the corellia
  // loader from ~/.zshrc like any other session.
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "font_size": 16
  }
}
